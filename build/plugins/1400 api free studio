def generer_config_litellm():
providers = []
for api in CATALOG["ai_llm"]:
if api["auth"] == "key":
providers.append({
"model_name": api["nom"].lower().replace(" ", "-"),
"litellm_params": {
"model": "provider/" + api["nom"].lower().replace(" ", "-"),
"api_key": "os.environ/" + api["nom"].upper().replace(" ", "_") + "_API_KEY",
}
})
config = {
"model_list": providers,
"litellm_settings": {
"drop_params": True,
"set_verbose": False,
"cache": True,
"cache_params": {
"type": "local",
"ttl": 3600
},
"num_retries": 3,
"request_timeout": 30,
},
"general_settings": {
"master_key": "sk-nexus-master-key",
"database_url": "sqlite:///" + os.path.join(BASE, "litellm.db"),
}
}
path = os.path.join(SCRIPTS_DIR, "litellm_config.yaml")
with open(path, "w", encoding="utf-8") as f:
json.dump(config, f, indent=2, ensure_ascii=False)
log("LiteLLM config : " + path)
return path


def generer_script_litellm():
script = '''#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# NEXUS LITELLM PROXY LAUNCHER
import os
import subprocess
import sys

CONFIG = os.path.join(os.path.dirname(__file__), "litellm_config.yaml")

if not os.path.isfile(CONFIG):
print("Config manquante :", CONFIG)
sys.exit(1)

env = os.environ.copy()
env.setdefault("LITELLM_MASTER_KEY", "sk-nexus-master-key")

cmd = [
sys.executable, "-m", "litellm",
"--config", CONFIG,
"--port", "4000",
"--host", "0.0.0.0",
"--detailed_debug",
]

print("Lancement LiteLLM sur http://localhost:4000")
print("Config :", CONFIG)
print("Cmd :", " ".join(cmd))
subprocess.call(cmd, env=env)
'''
path = os.path.join(SCRIPTS_DIR, "lance_litellm.py")
with open(path, "w", encoding="utf-8") as f:
f.write(script)
os.chmod(path, 0o755)
log("Launcher LiteLLM : " + path)
return path


