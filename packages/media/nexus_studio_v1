set -euo pipefail

# ───────────────────────────────────────────────────────────────────────────
# CONSTANTES
# ───────────────────────────────────────────────────────────────────────────

readonly VERSION="8.0.0"
readonly PROTOCOL="OMEGA 2900"
readonly SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PYTHON_SCRIPT="${SCRIPT_DIR}/nexus_film_studio.py"
readonly PID_FILE="/tmp/nexus_film_${$}.pid"
readonly LOG_FILE="${SCRIPT_DIR}/.nexus_launch.log"
readonly DEFAULT_PORTS=("8095" "8096" "8097" "8098" "8099" "3800" "8080" "8000")

# ───────────────────────────────────────────────────────────────────────────
# COULEURS & FORMATAGE
# ───────────────────────────────────────────────────────────────────────────

readonly RESET="\033[0m"
readonly RED="\033[31m"
readonly GREEN="\033[32m"
readonly YELLOW="\033[33m"
readonly BLUE="\033[34m"
readonly CYAN="\033[36m"
readonly MAGENTA="\033[35m"
readonly BOLD="\033[1m"

info()   { printf "${BLUE}[ℹ]${RESET} %s\n" "$*"; }
warn()   { printf "${YELLOW}[⚠]${RESET} %s\n" "$*"; }
error()  { printf "${RED}[✕]${RESET} %s\n" "$*" >&2; }
success(){ printf "${GREEN}[✓]${RESET} %s\n" "$*"; }
step()   { printf "\n${CYAN}▸${RESET} %s\n" "$*"; }

# ───────────────────────────────────────────────────────────────────────────
# UTILITAIRES
# ───────────────────────────────────────────────────────────────────────────

log_json() {
    local level="$1"
    shift
    local ts
    ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    printf '{"ts":"%s","lvl":"%s","src":"omega_launcher","msg":"%s"}\n' \
        "$ts" "$level" "$*" >> "$LOG_FILE"
}

die() {
    error "$@"
    log_json "error" "$*"
    cleanup
    exit 1
}

cleanup() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            info "Arrêt du processus (PID: $pid)..."
            kill "$pid" 2>/dev/null || true
            sleep 1
            kill -9 "$pid" 2>/dev/null || true
        fi
        rm -f "$PID_FILE"
    fi
}

trap 'die "Interruption"' INT TERM
trap cleanup EXIT

detect_python() {
    for cmd in python3 python; do
        if command -v "$cmd" >/dev/null 2>&1; then
            local version
            version=$("$cmd" --version 2>&1 | awk '{print $2}')
            echo "$cmd:$version"
            return 0
        fi
    done
    return 1
}

is_port_available() {
    local port="$1"
    ! ss -tuln 2>/dev/null | grep -q ":${port} " && \
    ! netstat -tuln 2>/dev/null | grep -q ":${port} "
}

find_free_port() {
    for port in "${DEFAULT_PORTS[@]}"; do
        if is_port_available "$port"; then
            echo "$port"
            return 0
        fi
    done
    warn "Tous les ports standards occupés. Essayons aléatoirement..."
    local rand_port=$((RANDOM % 8999 + 9000))
    echo "$rand_port"
}

check_requirements() {
    step "Vérification des prérequis..."
    
    local python_info
    if ! python_info="$(detect_python)"; then
        die "Python 3 non trouvé. Installez Python 3.8+"
    fi
    
    local python_path="${python_info%%:*}"
    local python_version="${python_info##*:}"
    
    info "Python détecté : ${python_version} (${python_path})"
    
    if [[ ! -f "$PYTHON_SCRIPT" ]]; then
        die "Script Python introuvable : ${PYTHON_SCRIPT}"
    fi
    
    success "Prérequis validés"
}

