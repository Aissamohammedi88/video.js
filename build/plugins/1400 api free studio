async function chargerApis(){
var cat = document.getElementById('cat-select').value;
var q = document.getElementById('search').value;
var url = '/api/apis?limit=500';
if(cat) url += '&categorie=' + encodeURIComponent(cat);
if(q) url += '&q=' + encodeURIComponent(q);
var res = document.getElementById('apis');
res.innerHTML = '<div class="loading">Chargement...</div>';
try{
var r = await fetch(url);
var d = await r.json();
var html = '';
(d.apis||[]).forEach(function(a){
var authBadge = a.auth === 'aucune' ? '<span class="badge free">no-auth</span>' : '<span class="badge warn">'+esc(a.auth)+'</span>';
var freeBadge = '<span class="badge alt">'+esc(a.free)+'</span>';
html += '<div class="api">'+
'<h3>'+esc(a.nom)+authBadge+freeBadge+'</h3>'+
'<div class="meta">'+esc(a.categorie)+' | '+esc(a.url)+'</div>'+
'<div class="meta"><a href="'+esc(a.doc)+'" target="_blank" style="color:#00c8ff">'+esc(a.doc)+'</a></div>'+
'</div>';
});
res.innerHTML = html || '<div class="loading">Aucune API trouvee</div>';
}catch(e){
res.innerHTML = '<div class="loading" style="color:#ff4444">Erreur</div>';
}
}

function chercherApi(){
clearTimeout(window._t);
window._t = setTimeout(chargerApis, 300);
}

