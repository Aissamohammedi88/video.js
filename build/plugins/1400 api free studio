def init_db():
conn = sqlite3.connect(DB_PATH, timeout=30)
c = conn.cursor()

c.execute("""CREATE TABLE IF NOT EXISTS catalogue (
id INTEGER PRIMARY KEY AUTOINCREMENT,
categorie TEXT,
nom TEXT,
url TEXT,
auth TEXT,
free TEXT,
doc TEXT)""")
c.execute("CREATE INDEX IF NOT EXISTS idx_cat_cat ON catalogue(categorie)")
c.execute("CREATE INDEX IF NOT EXISTS idx_cat_nom ON catalogue(nom)")

c.execute("""CREATE TABLE IF NOT EXISTS scripts (
id INTEGER PRIMARY KEY AUTOINCREMENT,
nom TEXT,
categorie TEXT,
fichier TEXT,
timestamp REAL)""")

c.execute("""CREATE TABLE IF NOT EXISTS apis_testees (
id INTEGER PRIMARY KEY AUTOINCREMENT,
nom TEXT,
url TEXT,
status INTEGER,
latence_ms REAL,
timestamp REAL)""")

conn.commit()

c.execute("SELECT COUNT(*) as n FROM catalogue")
row = c.fetchone()
if row[0] == 0:
for cat, apis in CATALOG.items():
for api in apis:
c.execute("INSERT INTO catalogue (categorie, nom, url, auth, free, doc) VALUES (?, ?, ?, ?, ?, ?)",
(cat, api["nom"], api["url"], api["auth"], api["free"], api["doc"]))
conn.commit()

c.execute("SELECT COUNT(*) as n FROM catalogue")
total = c.fetchone()[0]
conn.close()
log("DB : " + DB_PATH + " (" + str(total) + " APIs)")

catalogue = {"version": VERSION, "total": total, "categories": len(CATALOG),
