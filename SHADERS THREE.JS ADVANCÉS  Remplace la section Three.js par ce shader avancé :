// SHADERS CYBERPUNK AVANCÉS
const vertexShader = `
    varying vec3 vPosition;
    varying vec2 vUv;
    uniform float time;
    void main() {
        vPosition = position;
        vUv = uv;
        vec3 pos = position;
        pos.y += sin(pos.x * 2.0 + time) * 0.5;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
    }
`;

const fragmentShader = `
    varying vec3 vPosition;
    varying vec2 vUv;
    uniform float time;
    uniform vec3 color1;
    uniform vec3 color2;
    void main() {
        float wave = sin(vPosition.x * 3.0 + time) * cos(vPosition.y * 3.0 + time) * 0.5 + 0.5;
        vec3 color = mix(color1, color2, wave);
        float glow = smoothstep(0.4, 0.6, wave);
        color += vec3(glow) * 0.3;
        gl_FragColor = vec4(color, 1.0);
    }
`;
