class Handler(BaseHTTPRequestHandler):
def log_message(self, *a):
pass

def _send(self, code, content, ctype="application/json"):
try:
gz = None
if len(content) > 500 and "gzip" in self.headers.get("Accept-Encoding", ""):
content = gzip.compress(content, 6)
gz = "gzip"
self.send_response(code)
self.send_header("Content-Type", ctype + "; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
self.send_header("Access-Control-Allow-Headers", "Content-Type")
if gz:
self.send_header("Content-Encoding", gz)
self.send_header("Content-Length", str(len(content)))
self.end_headers()
self.wfile.write(content)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, obj, code=200):
self._send(code, json.dumps(obj, ensure_ascii=False, default=str).encode("utf-8"))

def _html(self, html):
self._send(200, html.encode("utf-8"), "text/html")

def do_OPTIONS(self):
self._send(204, b"")

def do_GET(self):
try:
u = urllib.parse.urlparse(self.path)
p = u.path
q = urllib.parse.parse_qs(u.query)

if p in ("/", "/index.html"):
html = HTML.replace("__V__", VERSION).replace("__AUTEUR__", AUTEUR)
html = html.replace("__TOTAL__", str(count_apis())).replace("__CATS__", str(count_categories()))
return self._html(html)

if p == "/api/health":
return self._json({"status": "ok", "version": VERSION})

if p == "/api/stats":
return self._json({
"version": VERSION,
"total_apis": count_apis(),
"categories": count_categories(),
"scripts": len(DEVOPS_TEMPLATES),
"templates": len(DEVOPS_TEMPLATES),
"timestamp": datetime.now(timezone.utc).isoformat(),
})

if p == "/api/categories":
cats = liste_categories()
tpls = [{"key": k, "nom": v["nom"], "description": v["description"]} for k, v in DEVOPS_TEMPLATES.items()]
return self._json({"categories": cats, "templates": tpls})

if p == "/api/apis":
cat = q.get("categorie", [None])[0]
recherche = q.get("q", [None])[0]
limit = int(q.get("limit", ["500"])[0])
return self._json({"apis": liste_apis(cat, recherche, limit)})

if p == "/api/template":
key = q.get("key", [""])[0]
if key in DEVOPS_TEMPLATES:
tpl = DEVOPS_TEMPLATES[key]
return self._json({"nom": tpl["nom"], "description": tpl["description"], "template": tpl["template"]})
return self._json({"erreur": "not found"}, 404)

if p == "/api/export":
content = json.dumps(CATALOG, indent=2, ensure_ascii=False).encode("utf-8")
self._send(200, content, "application/json")
return

return self._json({"erreur": "not found"}, 404)
except Exception as e:
return self._json({"erreur": str(e)[:200]}, 500)

def do_POST(self):
try:
u = urllib.parse.urlparse(self.path)
p = u.path

if p == "/api/litellm/config":
path = generer_config_litellm()
with open(path, "r", encoding="utf-8") as f:
content = f.read()
return self._json({"path": path, "contenu": content})

if p == "/api/litellm/launcher":
path = generer_script_litellm()
with open(path, "r", encoding="utf-8") as f:
content = f.read()
return self._json({"path": path, "contenu": content})

if p == "/api/fal/client":
path = generer_script_fal()
with open(path, "r", encoding="utf-8") as f:
content = f.read()
return self._json({"path": path, "contenu": content})

return self._json({"erreur": "not found"}, 404)
except Exception as e:
return self._json({"erreur": str(e)[:200]}, 500)


