async function loadCategories(){
try{
var r = await fetch('/api/categories');
var d = await r.json();
var sel = document.getElementById('cat-select');
(d.categories||[]).forEach(function(c){
var opt = document.createElement('option');
opt.value = c.categorie;
opt.textContent = c.categorie + ' (' + c.count + ')';
sel.appendChild(opt);
});
var tplDiv = document.getElementById('tpl-buttons');
(d.templates||[]).forEach(function(t){
var b = document.createElement('button');
b.className = 'tpl-btn';
b.textContent = t.nom;
b.onclick = function(){ chargerTemplate(t.key); };
tplDiv.appendChild(b);
