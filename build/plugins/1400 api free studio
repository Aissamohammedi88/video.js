def get_db():
conn = sqlite3.connect(DB_PATH, check_same_thread=False, timeout=30)
conn.row_factory = sqlite3.Row
try:
conn.execute("PRAGMA journal_mode = WAL")
conn.execute("PRAGMA synchronous = NORMAL")
except Exception:
pass
return conn


def count_apis():
conn = get_db()
try:
c = conn.cursor()
c.execute("SELECT COUNT(*) as n FROM catalogue")
return c.fetchone()[0]
finally:
conn.close()


def count_categories():
conn = get_db()
try:
c = conn.cursor()
c.execute("SELECT COUNT(DISTINCT categorie) as n FROM catalogue")
return c.fetchone()[0]
finally:
conn.close()


def liste_categories():
conn = get_db()
try:
c = conn.cursor()
c.execute("SELECT categorie, COUNT(*) as n FROM catalogue GROUP BY categorie ORDER BY n DESC")
return [{"categorie": r["categorie"], "count": r["n"]} for r in c.fetchall()]
finally:
conn.close()


def liste_apis(categorie=None, recherche=None, limit=500):
conn = get_db()
try:
c = conn.cursor()
if categorie and recherche:
c.execute("SELECT * FROM catalogue WHERE categorie = ? AND (nom LIKE ? OR url LIKE ?) LIMIT ?",
(categorie, "%" + recherche + "%", "%" + recherche + "%", limit))
elif categorie:
c.execute("SELECT * FROM catalogue WHERE categorie = ? LIMIT ?", (categorie, limit))
elif recherche:
c.execute("SELECT * FROM catalogue WHERE nom LIKE ? OR url LIKE ? LIMIT ?",
("%" + recherche + "%", "%" + recherche + "%", limit))
else:
c.execute("SELECT * FROM catalogue LIMIT ?", (limit,))
return [dict(r) for r in c.fetchall()]
finally:
conn.close()


